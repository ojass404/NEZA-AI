<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" width="${width}" height="${height}">
  <defs>
    <!-- Acoustic waterfall sediment backscatter gradient -->
    <radialGradient id="sonarGlow" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#1E3258" />
      <stop offset="60%" stop-color="#132448" />
      <stop offset="100%" stop-color="#0A1428" />
    </radialGradient>
    
    <pattern id="sonarScanlines" width="100" height="4" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="100" y2="0" stroke="#E8C766" stroke-width="0.3" opacity="0.12" />
      <line x1="0" y1="2" x2="100" y2="2" stroke="#000" stroke-width="0.3" opacity="0.18" />
    </pattern>

    <pattern id="sedimentRipples" width="40" height="20" patternUnits="userSpaceOnUse">
      <path d="M 0 10 Q 10 7, 20 10 T 40 10" fill="none" stroke="#E8C766" stroke-width="0.5" opacity="0.15" />
      <path d="M 0 18 Q 15 15, 30 18 T 40 18" fill="none" stroke="#3361AC" stroke-width="0.4" opacity="0.2" />
    </pattern>
  </defs>

  <!-- Background Acoustic Field -->
  <rect width="${width}" height="${height}" fill="url(#sonarGlow)" />
  <rect width="${width}" height="${height}" fill="url(#sedimentRipples)" />
  <rect width="${width}" height="${height}" fill="url(#sonarScanlines)" />

  <!-- Center Nadir Track (Water column acoustic dead zone directly below towfish) -->
  <rect x="${halfWidth - nadirWidth / 2}" y="0" width="${nadirWidth}" height="${height}" fill="#040814" />
  <line x1="${halfWidth}" y1="0" x2="${halfWidth}" y2="${height}" stroke="#3361AC" stroke-width="1" stroke-dasharray="6,4" opacity="0.6" />
  
  <!-- Port / Starboard Range Calipers (Water-fall markings) -->
  <g stroke="#3361AC" stroke-width="0.5" opacity="0.35">
    <line x1="${halfWidth - 250}" y1="0" x2="${halfWidth - 250}" y2="${height}" stroke-dasharray="2,6" />
    <line x1="${halfWidth - 500}" y1="0" x2="${halfWidth - 500}" y2="${height}" stroke-dasharray="2,6" />
    <line x1="${halfWidth + 250}" y1="0" x2="${halfWidth + 250}" y2="${height}" stroke-dasharray="2,6" />
    <line x1="${halfWidth + 500}" y1="0" x2="${halfWidth + 500}" y2="${height}" stroke-dasharray="2,6" />
  </g>

  <!-- Channel Indicators -->
  <text x="40" y="30" fill="#E8C766" opacity="0.6" font-family="monospace" font-size="12" letter-spacing="1">PORT CHANNEL (410 kHz)</text>
  <text x="${halfWidth - 14}" y="30" fill="#3361AC" opacity="0.7" font-family="monospace" font-size="10" text-anchor="middle">NADIR</text>
  <text x="${width - 240}" y="30" fill="#E8C766" opacity="0.6" font-family="monospace" font-size="12" letter-spacing="1">STARBOARD CHANNEL (410 kHz)</text>

  <!-- Targets and Acoustic Shadows -->
  ${targetElements}

  <!-- Watermark / Telemetry overlay -->
  <g opacity="0.4" font-family="monospace" font-size="11" fill="#E7E6DD">
    <text x="30" y="${height - 20}">MoES / NIOT SSS HYDROGRAPHIC SURVEY - ${title}</text>
    <text x="${width - 280}" y="${height - 20}">ALT: 12.5m | SPD: 3.8kt | RANGE: 75m</text>
  </g>
</svg>